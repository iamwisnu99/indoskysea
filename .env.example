# Domain / Site URL (Default: https://indoskysea.primadev.id)
# Ubah jika berganti ke custom domain utama seperti https://indoskysea.com atau https://indoskysea.id
NEXT_PUBLIC_SITE_URL=https://indoskysea.primadev.id

# Aisstream.io API Key (Dapatkan gratis di https://aisstream.io)
AISSTREAM_API_KEY=

# OpenSky Network Credentials (Opsional, dapatkan di https://opensky-network.org)
# Kosongkan jika ingin menggunakan anonymous access dengan rate limit publik
OPENSKY_USERNAME=
OPENSKY_PASSWORD=